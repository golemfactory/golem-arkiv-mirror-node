FROM rust:1.90-bookworm AS build
WORKDIR /work
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY vendor ./vendor
# arkiv-node compiles this genesis preset in (genesis_authoring.rs).
COPY docs/examples/genesis-bundle/profiles ./docs/examples/genesis-bundle/profiles
RUN cargo build --locked --release -p arkiv-node --bin arkiv-simulator

FROM debian:bookworm-slim
# curl serves container health checks against the public status endpoint.
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --create-home simulator \
    && mkdir /data && chown simulator:simulator /data
COPY --from=build /work/target/release/arkiv-simulator /usr/local/bin/arkiv-simulator
USER simulator
WORKDIR /data
# The binary listens on 127.0.0.1:9400 by default; pass --listen 0.0.0.0:9400
# to reach it from outside the container.
EXPOSE 9400
ENTRYPOINT ["arkiv-simulator"]
